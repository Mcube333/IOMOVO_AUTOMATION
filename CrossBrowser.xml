<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- 
    TestNG Suite Configuration File 
    - This file defines a test suite named "CrossBrowserSuite" to execute tests in parallel across multiple browsers.
    - The 'parallel' attribute is set to "tests", meaning each test (Chrome, Firefox, Edge) will run independently in parallel.
    - The 'thread-count' is set to 3, allowing up to 3 parallel test executions.
-->
<suite name="CrossBrowserSuite" parallel="tests" thread-count="3">

    <!-- 
        Test Configuration for Chrome Browser 
        - A test named "ChromeTest" is defined.
        - A parameter "browser" with value "chrome" is passed to the test.
    -->
    <test name="ChromeTest">
        <parameter name="browser" value="chrome"/>
        <classes>
           <class name="com.iomovo.dashboardtests.LoginPageTest">
             <methods>
                    <include name="LoginMethod"/>
                </methods>
           </class>
        </classes>
    </test>

    <!-- 
        Test Configuration for Firefox Browser 
        - A test named "FirefoxTest" is defined.
        - A parameter "browser" with value "firefox" is passed to the test.
    -->
    <test name="FirefoxTest">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.iomovo.dashboardtests.LoginPageTest">
             <methods>
                    <include name="LoginMethod"/>
                </methods>
           </class>
        </classes>
    </test>

    <!-- 
        Test Configuration for Edge Browser 
        - A test named "EdgeTest" is defined.
        - A parameter "browser" with value "edge" is passed to the test.
    -->
    <test name="EdgeTest">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.iomovo.dashboardtests.LoginPageTest">
             <methods>
                    <include name="LoginMethod"/>
                </methods>
           </class>
        </classes>
    </test>

</suite>
